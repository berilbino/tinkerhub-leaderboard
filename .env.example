# ============================================================
# TinkerHub Leaderboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Admin Access Code ───────────────────────────────────────
# Set a strong, secret code that only your admins know.
# Required for this project: ADMIN2026 (change it after launch if possible)
# This is the ONLY code accepted at the Admin Portal login.
ADMIN_ACCESS_CODE=ADMIN2026

# A long random secret used to sign the secure admin-session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
